# --- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# --- Virtual environments -----------------------------------------------
.venv/
venv/
env/

# --- Secrets --------------------------------------------------------------
# Real values live in .env, filled in from .env.example. Never commit it.
.env

# --- Test / tool artifacts ------------------------------------------------
.pytest_cache/
pytest_tmp/
.pytest_tmp/
.pytest-basetemp/
.coverage
htmlcov/

# --- AI coding assistant tooling ------------------------------------------
.agents/
.claude/

# --- Stray files from local shell mistakes (e.g. a PowerShell paste) ------
-Uri

# --- Spark pipeline output (regenerated by pyspark/*.py — see README) -----
# document_chunks.jsonl is the one file under data/processed/ that's
# committed on purpose (see Dockerfile's comment on why) — this pattern
# only matches the *.parquet output directories, not it.
data/processed/*.parquet/
# Exception: the two committed REFERENCE outputs (2.2 MB) that
# tests/test_anomaly_rules.py compares the engine against byte-for-byte.
# CI has no other copy, so without these that test cannot run there.
!data/processed/sensor_summary.parquet/
!data/processed/machine_anomalies.parquet/
*.crc

# --- Raw source data too large to commit -----------------------------------
# Regenerated by scripts/generate_synthetic_data.py (seed=42). Not needed
# to run the API/frontend/CI path, which is seeded from the committed
# sql/seed.sql.gz — this file is only an intermediate the pipeline reads.
data/raw/synthetic_operational.csv

# --- IDE / OS ---------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
# Phase 5: connector secret files (CONNECTOR_SECRETS_HOST_DIR). Never commit.
secrets/

backups/
data/storage/
*.dump

backups/
data/storage/
*.dump

backups/
data/storage/
*.dump
