# Copy to .env and fill in. Never commit .env.
# Every variable app/core/config.py reads, with its default where it has one.

# --- PostgreSQL -----------------------------------------------------------
# OWNER/admin connection: alembic, scripts/*, backups, test fixtures.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5434/industrial_intelligence
# Phase 2 (RLS): the API connects as the least-privilege role iia_app.
# Create it with: APP_DB_PASSWORD=... python scripts/provision_app_role.py
# Unset -> the API falls back to DATABASE_URL (owner bypasses RLS: warns locally,
# refuses to start on a remote database unless RLS_REQUIRED=false).
APP_DATABASE_URL=postgresql://iia_app:CHANGE_ME@localhost:5434/industrial_intelligence
APP_DB_PASSWORD=CHANGE_ME
RLS_REQUIRED=

# docker compose only
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=industrial_intelligence

# --- Security -------------------------------------------------------------
API_KEY=CHANGE_ME_LONG_RANDOM_STRING
AUTH_REQUIRED=
CORS_ALLOW_ORIGINS=
RATE_LIMIT_PER_MINUTE=30

# Phase 4 human login (POST /auth/login). REQUIRED to enable it, no defaults: leave
# unset and login answers 503 (API keys and the demo posture are unaffected).
# JWT_SECRET: at least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=
JWT_TTL_MINUTES=60

# --- LLM / agent ----------------------------------------------------------
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=2
GRAPH_RECURSION_LIMIT=40
GEMINI_MODEL=
GEMINI_LOCATION=global
GEMINI_SYNTHESIS_ENABLED=false
AGENTIC_ROUTING_ENABLED=
PLANNER_MODEL=

# --- RAG ------------------------------------------------------------------
RAG_BACKEND=local
RAG_CHUNK_SIZE=
RAG_CHUNK_OVERLAP=
RAG_TOP_K=
PINECONE_API_KEY=
PINECONE_INDEX=industrial-intelligence
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=maintenance-docs
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

# --- Frontend -------------------------------------------------------------
API_BASE_URL=http://localhost:8000

# --- Phase 5: pull connector (GCS) -------------------------------------------
# Demo: the compose `gcs-emulator` service (anonymous). For REAL GCS set STORAGE_EMULATOR_HOST= (empty);
# connectors must then name a secret_ref. A secret_ref is a NAME; its value (a service-account key JSON)
# is read at run time from CONNECTOR_SECRET__<REF> (REF upper-cased, non A-Z0-9 -> _) or from a file named
# <ref> in CONNECTOR_SECRETS_DIR. A real secrets manager is NOT implemented.
STORAGE_EMULATOR_HOST=http://gcs-emulator:4443
CONNECTOR_SECRETS_HOST_DIR=./secrets
CONNECTOR_TICK_SECONDS=30
CONNECTOR_LEASE_SECONDS=900
CONNECTOR_MAX_OBJECTS_PER_RUN=25
CONNECTOR_MIN_AGE_SECONDS=60
CONNECTOR_OVERLAP_SECONDS=3600
CONNECTOR_OBJECT_MAX_ATTEMPTS=5
CONNECTOR_MIN_INTERVAL_SECONDS=300
CONNECTOR_MAX_PER_TENANT=5

# Demo seeding (docker compose `seed` service, scripts/seed_demo.py). Passwords for the demo logins
# admin@company-b.example, viewer@company-b.example and admin@default.example. >= 12 characters, required.
DEMO_ADMIN_PASSWORD=CHANGE_ME_12_CHARS_MIN
DEMO_VIEWER_PASSWORD=CHANGE_ME_12_CHARS_MIN





# Worker DB role (required by compose)
WORKER_DB_PASSWORD=CHANGE_ME
WORKER_DATABASE_URL=postgresql://iia_worker:CHANGE_ME@localhost:5434/industrial_intelligence
